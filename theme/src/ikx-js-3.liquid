  }
  /* Same checks and messages Shopify checkout shows: mobile first, then delivery, email last (optional). */
  function invalid(d) {
    return d.first_name.length < 1 ? ['first_name', 'Enter a first name'] :
      d.last_name.length < 1 ? ['last_name', 'Enter a last name'] :
      !d.phone ? ['phone', 'Enter your mobile number'] :
      d.phone.length > 10 ? ['phone', 'Only 10 digits allowed'] :
      !/^[6-9]\d{9}$/.test(d.phone) ? ['phone', 'Enter a valid 10-digit mobile number'] :
      d.address1.length < 5 ? ['address1', 'Enter your house / flat no. and street'] :
      /(https?:\/\/|www\.|maps\.app|goo\.gl|\.com\/)/i.test(d.address1) ? ['address1', 'Please type your address. Links are not accepted'] :
      d.address2.length < 3 ? ['address2', 'Enter a landmark, it helps the courier find you'] :
      /(https?:\/\/|www\.|maps\.app|goo\.gl|\.com\/)/i.test(d.address2) ? ['address2', 'Please type a landmark. Links are not accepted'] :
      !d.city ? ['city', 'Enter a city'] :
      !d.state ? ['state', 'Select a state'] :
      !/^\d{6}$/.test(d.pincode) ? ['pincode', 'Enter a valid 6-digit PIN code'] :
      (d.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(d.email)) ? ['email', 'Enter a valid email, or leave it empty'] : null;
  }
