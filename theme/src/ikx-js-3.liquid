    box.innerHTML = (state.ups || []).slice(0, 2).map(function (u) {
      var on = added.indexOf(String(u.variantId)) >= 0, now = Math.round(u.price * (100 - u.pct) / 100);
      return '<div class="ikx-up' + (on ? ' is-on' : '') + '">' + (u.image ? '<img src="' + esc(u.image) + '" alt="" loading="lazy">' : '') +
