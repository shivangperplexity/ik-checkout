  /* ---------- delivery form ---------- */
  /* Build 066: digits only, +91 / leading 0 dropped, NOT cut to 10 (more than 10 is shown as an error) */
  function phoneDigits(v) {
    var d = String(v || '').replace(/\D/g, '');
    if (d.length >= 12 && d.indexOf('91') === 0) d = d.slice(2);
    if (d.length === 11 && d.charAt(0) === '0') d = d.slice(1);
    return d;
  }
  function tenDigits(v) { return phoneDigits(v).slice(0, 10); }
  /* PIN fills city + state; when it works, they collapse into one confirmed line (design: "Baner, Pune ✓"). */
  var pinSeq = 0, PINS = {}; /* this page view only, never stored */
  function onPin() {
    var f = form(), pin = f.elements.pincode.value.trim();
    if (!/^\d{6}$/.test(pin)) { state.pinOk = false; return; }
    var seq = ++pinSeq;
    function apply(d) {
      if (seq !== pinSeq) return;
      if (!d.ok) { state.pinOk = false; return; }
      var match = STATES.filter(function (s) { return s.toLowerCase() === String(d.state).toLowerCase(); })[0];
      f.elements.city.value = d.city || f.elements.city.value;
      if (match) f.elements.state.value = match;
      state.pinOk = !!(f.elements.city.value && f.elements.state.value);
      if (match) f.elements.state.closest('.ikx-in').classList.add('is-filled');
      paintShip(); paintFoot();
    }
    if (PINS[pin]) return apply(PINS[pin]);
    fetch(API + '/api/pincode/' + pin).then(function (r) { return r.json(); }).then(function (d) {
      if (d.ok) PINS[pin] = { ok: true, city: d.city, state: d.state };
      apply(d);
    }).catch(function () {});
  }
  function paintPinOk(text, checking) {
    var ok = $('.ikx-pinok', root), cs = $('.ikx-cityst', root); if (!ok) return;
    if (checking) { ok.innerHTML = '<i class="ikx-spin ikx-spin--pin"></i><span>Checking PIN…</span>'; ok.hidden = false; cs.hidden = true; return; }
    if (text) { ok.innerHTML = '<span class="ikx-ic">' + ICON.check + '</span><span>' + esc(text) + '</span><button type="button" class="ikx-link" data-ikx-city>Change</button>'; ok.hidden = false; cs.hidden = true; }
    else { ok.hidden = true; cs.hidden = false; }
  }

  /* What the shopper typed is kept in memory for this page only (never saved), so coming back from the UPI app,
     "Pay another way" or a failed payment shows the same filled-in form instead of an empty one. */
  function restoreDraft(d) {
    var f = form(); if (!f || !d) return;
    ['phone', 'first_name', 'last_name', 'pincode', 'city', 'state', 'address1', 'address2', 'email'].forEach(function (k) { if (d[k] && f.elements[k]) f.elements[k].value = d[k]; });
    if (!d.first_name && d.name) { var nm = d.name.split(' '); f.elements.first_name.value = nm.shift(); f.elements.last_name.value = nm.join(' '); }
    if (f.elements.state.value) f.elements.state.closest('.ikx-in').classList.add('is-filled');
    if (d.city && d.state && /^\d{6}$/.test(d.pincode)) { state.pinOk = true; paintPinOk(d.city + ', ' + d.state); }
    paintShip();
  }
  function formData() {
    var f = form(), o = {};
    ['phone', 'first_name', 'last_name', 'pincode', 'city', 'state', 'address1', 'address2', 'email'].forEach(function (k) { o[k] = (f.elements[k] && f.elements[k].value || '').trim(); });
    o.phone = phoneDigits(o.phone);
    /* The API takes name + email + phone: derive the name from Shopify's first/last fields. */
    o.name = (o.first_name + ' ' + o.last_name).trim();
    o.news = !!(f.elements.news && f.elements.news.checked);
