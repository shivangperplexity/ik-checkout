/* ik-express.js part 3 of 5 (rendered inline by snippets/ik-checkout.liquid) */
        '<a class="ikx-item__img" href="' + esc(it.url) + '">' + (it.image ? '<img src="' + esc(img(it.image, 160)) + '" alt="" loading="lazy">' : '') + '</a>' +
