  }

  /* Build 038: designs that are truly free right now, bestsellers first (PICKS order). With an odd number of
     tattoos, one more is free only if it costs no more than the cheapest tattoo still being paid for (Buy 1 Get 1
     frees the cheapest half); a pricier one would add the difference, so it is not offered as free. */
  function freePicks(c, b) {
    if (!c || !b || !b.odd) return [];
    var units = [], inCart = {};
    c.items.forEach(function (i) { inCart[i.product_id] = 1; if (i.product_type === TATTOO) for (var k = 0; k < i.quantity; k++) units.push(i.original_price); });
    units.sort(function (x, y) { return x - y; });
    var paidMin = units[Math.floor(units.length / 2)] || 0;
    return PICKS.filter(function (p) { return !inCart[p.id] && p.p <= paidMin; });
  }
  /* One tap = added (the whole tile is the button). */
  function freeTile(p) {
    return '<button type="button" class="ikx-fp__i" data-ikx-add="' + p.v + '" aria-label="Add ' + esc(p.t) + ' for free"' + (state.busy ? ' disabled' : '') + '>' +
