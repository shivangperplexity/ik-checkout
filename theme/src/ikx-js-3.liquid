  function stepWatch() {
    var d = formData();
    if (/^[6-9]\d{9}$/.test(d.phone)) tkOnce('phone', { phone: d.phone, name: d.name });
    if (/^\d{6}$/.test(d.pincode)) tkOnce('pin');
    if (d.name.length > 1 && d.address1.length > 4) tkOnce('address');
    if (!invalid(d)) tkOnce('pay', { phone: d.phone, name: d.name });
  }

  /* ---------- add-on offers (set in the admin dashboard) ---------- */
