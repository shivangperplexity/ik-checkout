            '<button type="button" data-ikx-qty="-1" aria-label="Decrease quantity"' + (state.busy || /^tmp-/.test(it.key) ? ' disabled' : '') + '>' + (it.quantity > 1 ? '−' : ICON.trash) + '</button>' +
            '<span aria-live="polite">' + it.quantity + '</span>' +
