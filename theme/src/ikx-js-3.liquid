      '<span class="ikx-fp__t">' + esc(p.t) + '</span>' +
      '<span class="ikx-fp__p"><s>' + money(p.p) + '</s><b>+ Add</b></span></button>';
  }

  /* Optimistic: the sheet updates on tap; Shopify's cart and the price catch up in the background. */
  var cartQ = Promise.resolve(), pending = 0;
  function clone(c) { return JSON.parse(JSON.stringify(c)); }
  /* A request started just before the shopper switched to a UPI app can hang forever on some phones;
     give each cart change 12 s so one stuck request never blocks the + / − / delete buttons after it. */
  function within(ms, p) { return Promise.race([p, new Promise(function (_, bad) { setTimeout(function () { bad(new Error('timeout')); }, ms); })]); }
  function cartOp(run) {
    pending++; ownUntil = Date.now() + 4000;
    cartQ = cartQ.then(function () { return within(12000, run()); }).then(function (real) {
      if (--pending === 0) {
        ownUntil = Date.now() + 1500;
        /* Never redraw the cart over a payment in progress (that showed a locked cart); just keep the data. */
        if (state.busy) { CART = real; return; }
        render(real); notify();
      }
    }).catch(function (err) {
      pending = Math.max(0, pending - 1);
      showErr(err && err.message === 'add' ? 'That design just sold out. Please pick another.' : 'Could not update your cart. Please try again.');
      if (state.busy) return;
      return refresh();
    });
  }
  function changeQty(key, delta) {
    var c = clone(CART), it = c.items.filter(function (i) { return i.key === key; })[0]; if (!it) return;
    var q = Math.max(0, it.quantity + delta);
    it.quantity = q; it.original_line_price = it.original_price * q;
    c.items = c.items.filter(function (i) { return i.quantity > 0; }); recount(c);
    render(c);
    cartOp(function () {
      return fetch(R + 'cart/change.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ id: key, quantity: q }) })
        .then(function (r) { if (!r.ok) throw new Error('change'); return r.json(); });
    });
  }
  function addPick(v) {
    var p = PICKS.filter(function (x) { return String(x.v) === String(v); })[0];
    if (p) {
      var c = clone(CART);
      c.items.push({ key: 'tmp-' + v, variant_id: Number(v), product_id: p.id, quantity: 1, original_price: p.p, original_line_price: p.p, final_price: p.p, product_title: p.t, variant_title: '', product_type: TATTOO, image: p.img, url: p.u });
      recount(c); render(c);
    }
    tk('method', { method: state.method, data: { pick: true } });
    cartOp(function () {
      return fetch(R + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: [{ id: Number(v), quantity: 1 }] }) })
        .then(function (r) { if (!r.ok) throw new Error('add'); return fetch(R + 'cart.js', { headers: { Accept: 'application/json' } }); })
        .then(function (r) { return r.json(); });
