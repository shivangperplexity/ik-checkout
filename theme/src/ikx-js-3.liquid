    if (b.count && box) {
      box.classList.remove('is-free');
      box.setAttribute('style', 'padding:0;border:0;background:none;box-shadow:none;margin-bottom:10px');
      box.innerHTML = '<div role="status" style="position:relative;overflow:hidden;border-radius:999px;background:#f1ece2;height:36px">' +
        '<i aria-hidden="true" style="position:absolute;left:0;top:0;bottom:0;width:' + (b.odd ? 50 : 100) + '%;background:' + (b.odd ? '#f6d77e' : '#cfe9d4') + ';transition:width .4s ease"></i>' +
        '<span style="position:relative;display:flex;align-items:center;justify-content:center;height:100%;padding:0 14px;font-size:13px;font-weight:700;color:#1d1a14;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">' +
