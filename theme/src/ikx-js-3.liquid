    var pb = $('.ikx-picks', root);
    if (!picks.length) { pb.innerHTML = ''; return; }
    pb.innerHTML = '<p class="ikx-h3">' + (b.odd ? 'Pick your FREE tattoo' : 'You might have missed') + '<small>' + (b.odd ? 'Swipe →' : 'Add 2 · 1 free') + '</small></p>' +
      '<div class="ikx-rail">' + picks.map(function (p) {
        return '<div class="ikx-pick"><a class="ikx-pick__img" href="' + esc(p.u) + '">' + (p.img ? '<img src="' + esc(p.img) + '" alt="" loading="lazy">' : '') + (b.odd ? '<span>FREE</span>' : '') + '</a>' +
          '<span class="ikx-pick__t">' + esc(p.t) + '</span>' +
          '<span class="ikx-pick__p">' + (b.odd ? '<s>' + money(p.p) + '</s> <b class="ikx-green">FREE</b>' : '<b>' + money(p.p) + '</b>') + '</span>' +
          '<button type="button" class="ikx-pick__b' + (b.odd ? ' is-free' : '') + '" data-ikx-add="' + p.v + '" aria-label="Add ' + esc(p.t) + (b.odd ? ' free' : '') + '"' + (state.busy ? ' disabled' : '') + '>' + (b.odd ? '+ Add FREE' : '+ Add') + '</button></div>';
