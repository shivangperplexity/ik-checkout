/* ik-express.js part 5 of 5 (rendered inline by snippets/ik-checkout.liquid) */
            if (j.why === 'review') { state.done = true; return screen('<h3>Payment received</h3><p>We got your payment and are confirming your order. You’ll hear from us shortly. Please don’t pay again.</p><button type="button" class="ikx-btn" data-ikx-close>OK</button>'); }
            payFailed('Payment didn’t go through. No money was taken. Try again or choose Cash on delivery.');
          }).catch(function () { state.done = true; screen('<h3>Checking your payment</h3><p>If money was deducted, your order will be confirmed shortly. Please don’t pay again.</p><button type="button" class="ikx-btn" data-ikx-close>OK</button>'); });
        },
        catchException: function () { if (done) return; done = true; payFailed('Could not open the payment window. Please try again.'); }
      });
    }).catch(function () { overlay('Redirecting to secure payment…'); redirectPayu(p); });
  }

  /* Own UPI buttons: PayU creates the intent, we open the shopper's app and poll for the result. */
  var UPI_SCHEME = { gpay: 'tez://upi/pay?', phonepe: 'phonepe://pay?', paytm: 'paytmmp://pay?' };
  function goUpi(r, app) {
    hideOverlay();
    var base = r.upi.uri.replace(/^upi:\/\/pay\?/, '');
    var link = (UPI_SCHEME[app] || 'upi://pay?') + base;
    var started = Date.now(), stopped = false, timer = null, tick = null, WINDOW = 5 * 60;
    var appName = (UPI_APPS.filter(function (a) { return a[0] === app; })[0] || [0, 'your UPI app'])[1];
    if (app === 'any') appName = 'your UPI app';
    function stop() { stopped = true; clearTimeout(timer); clearInterval(tick); document.removeEventListener('visibilitychange', onVis); root.removeEventListener('click', onUpiClick); }
    function onVis() { if (!document.hidden) check(); }
    function left() { return Math.max(0, WINDOW - Math.floor((Date.now() - started) / 1000)); }
    function clock() { var n = left(); return Math.floor(n / 60) + ':' + ('0' + (n % 60)).slice(-2); }
    function waiting() {
      screen('<div class="ikx-ring"><b>' + clock() + '</b><span>left</span></div><h3>Approve ' + money(r.advance || state.quote.prepaid.total) + ' in ' + esc(appName) + '</h3>' +
        '<ol class="ikx-steps3"><li>Open ' + esc(appName) + '</li><li>Tap the payment request</li><li>Enter your UPI PIN</li></ol>' +
        '<p class="ikx-m">This page updates by itself. Please keep it open.</p>' +
        '<button type="button" class="ikx-btn" data-ikx-open>Open ' + esc(appName) + ' again</button><button type="button" class="ikx-btn ikx-btn--ghost" data-ikx-other>Pay another way</button>');
      clearInterval(tick);
      tick = setInterval(function () {
        if (stopped) return clearInterval(tick);
        var t = $('.ikx-ring b', root); if (t) t.textContent = clock();
        if (left() <= 0) { stop(); screen('<h3>Payment time ran out</h3><p>If money was deducted, your order will be confirmed shortly. Otherwise you can try again.</p><button type="button" class="ikx-btn" data-ikx-retry>Try again</button>'); }
      }, 1000);
    }
    function check() {
      if (stopped) return; clearTimeout(timer);
      fetch(API + '/api/payu/status', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ txnid: r.txnid }) })
        .then(function (x) { return x.json(); }).then(function (j) {
          if (stopped) return;
          if (j.state === 'paid') {
            stop(); tk('done');
            fetch(R + 'cart/clear.js', { method: 'POST' }).catch(function () {});
            track('Purchase', { currency: 'INR', value: j.value }, j.eventId);
            return showSuccess({ orderName: j.orderName, statusUrl: j.statusUrl, method: j.partial ? 'partial' : 'prepaid', value: j.value, advance: j.advance, balance: j.balance });
          }
          if (j.state === 'review') { stop(); state.done = true; return screen('<h3>Payment received</h3><p>We got your payment and are confirming your order. You’ll hear from us shortly. Please don’t pay again.</p><button type="button" class="ikx-btn" data-ikx-close>OK</button>'); }
          if (j.state === 'failed') { stop(); return back('Payment didn’t go through. No money was taken. Try again or choose another method.'); }
          next();
        }).catch(next);
    }
    function next() { if (!stopped) timer = setTimeout(check, 3000); }
    /* Back to the cart after a UPI attempt: unlock everything and redraw from the cart we already have,
       straight away, then sync with Shopify quietly (the first request after returning from a UPI app often
       fails or stalls, which used to leave the screen stuck until a page refresh). */
    function back(msg) {
      state.idem = uuid(); state.busy = false; state.done = false; state.built = false;
      hideOverlay(); root.style.visibility = '';
      if (CART && CART.item_count) render(CART); else loadingView('Loading your cart…');
      if (msg) showErr(msg);
      within(10000, getCart()).then(function (c) { if (state.busy || state.done) return; if (!CART_SHOWN || sigOf(linesOf(c)) !== sigOf(linesOf(CART_SHOWN)) || !state.built) render(c); if (msg) showErr(msg); })
        .catch(function () { if (!state.built && !(CART && CART.item_count)) screen('<h3>Couldn’t load your cart</h3><p>Please check your connection and try again.</p><button type="button" class="ikx-btn" data-ikx-retry>Try again</button>'); });
    }
    function onUpiClick(e) {
      var t = e.target instanceof Element ? e.target : null; if (!t) return;
      if (t.closest('[data-ikx-open]')) location.href = link;
      else if (t.closest('[data-ikx-other]')) { stop(); back(''); }
    }
    root.addEventListener('click', onUpiClick);
    root.addEventListener('click', function h(e) { if (e.target instanceof Element && e.target.closest('[data-ikx-retry]')) { root.removeEventListener('click', h); back(''); } });
    document.addEventListener('visibilitychange', onVis);
    tk('upi', { data: { app: app } });
    location.href = link; /* open the UPI app first; the waiting screen is drawn behind it */
    waiting(); timer = setTimeout(check, 4000);
  }

  function showSuccess(r) {
    var part = r.method === 'partial', cod = r.method === 'cod' || part, d = state.draft || {}, c = CART_SHOWN || CART || { items: [] };
    state.done = true; state.busy = false; state.idem = ''; state.draft = null;
    var items = (c.items || []).map(function (it) {
      return '<li class="ikx-done__it">' + (it.image ? '<img src="' + esc(img(it.image, 96)) + '" alt="">' : '') + '<span>' + esc(it.product_title) + (it.quantity > 1 ? ' × ' + it.quantity : '') + '</span></li>';
    }).join('');
    var addr = d.first_name ? '<p class="ikx-done__addr"><b>Delivering to</b><br>' + esc(d.name) + '<br>' + esc(d.address1) + (d.address2 ? ', ' + esc(d.address2) : '') + '<br>' + esc(d.city) + ', ' + esc(d.state) + ' ' + esc(d.pincode) + '<br>+91 ' + esc(d.phone) + '</p>' : '';
    var when = SHIP.edd ? '<p class="ikx-done__edd">' + ICON.truck + 'Express shipping · arrives by <b>' + esc(SHIP.edd) + '</b></p>' : '';
    /* COD (not part-paid): the order ships only after the customer confirms on WhatsApp */
    var confirmNote = cod && !part ? '<div class="ikx-tip ikx-tip--warn" style="background:#fff6e6;border:1px solid #f0c36d;color:#5c3b00"><b>Please confirm your order on WhatsApp</b><span>We have sent you a WhatsApp message. Tap “Yes” to confirm, otherwise the order will be cancelled automatically.</span></div>' : '';
    screen('<div class="ikx-tick">' + ICON.check + '</div><h3>' + (cod && !part ? 'Order placed' : cod ? 'Order confirmed' : 'Thank you, you’re all set') + (r.orderName ? ' · ' + esc(r.orderName) : '') + '</h3>' +
      '<p>' + (part ? (r.advance ? 'Advance of ' + money(r.advance) + ' received. Pay ' + money(r.balance) + ' when your order arrives.' : 'Advance received. Pay the rest when your order arrives.') : cod ? 'Your Cash on delivery order is placed.' : 'Payment received' + (r.value ? ' · ' + money(Math.round(r.value * 100)) : '') + '.') + (cod && !part ? '' : ' We’ll pack it today and send tracking on WhatsApp.') + '</p>' +
      confirmNote + (items ? '<ul class="ikx-done__items">' + items + '</ul>' : '') + when + addr +
      (!cod && mys() ? '<div class="ikx-tip" style="background:#f6fef9;border:1px solid #a6f4c5;color:#05603a"><b>🎁 Your FREE mystery tattoo is on its way</b><span>A surprise design, packed in the same parcel. Thank you for paying online!</span></div>' : '') +
      '<div class="ikx-tip"><b>For the best result</b><span>Apply on clean, dry skin. The ink darkens over 24 hours.</span></div>' +
      (r.statusUrl ? '<a class="ikx-btn" href="' + esc(r.statusUrl) + '">Track order</a>' : '') +
      '<button type="button" class="ikx-btn ikx-btn--ghost" data-ikx-close>Continue shopping</button>');
  }

  /* ---------- post-payment landings (?ik_paid=1 / ?ik_pay=… from the API redirect flow) ---------- */
  function boot() {
    /* Clean up keys from older checkout builds (ikx_buyer is the one this build uses). */
    try { ['ik_addrs', 'ik_buyer', 'ikx_pins'].forEach(function (k) { localStorage.removeItem(k); }); } catch (e) {}
    getCart().then(function (c) { setTimeout(function () { prefetch(c); }, 800); }).catch(function () {});
    if (qs.get('ik_paid') === '1') {
      fetch(R + 'cart/clear.js', { method: 'POST' }).catch(function () {});
      track('Purchase', { currency: 'INR', value: parseFloat(qs.get('v')) || 0 }, qs.get('e'));
      shell(); root.classList.add('is-open'); document.documentElement.style.overflow = 'hidden';
      showSuccess({ orderName: qs.get('o'), statusUrl: qs.get('u'), method: qs.get('pa') ? 'partial' : 'prepaid', advance: Number(qs.get('pa')) || 0, balance: Number(qs.get('pb')) || 0 });
      history.replaceState(null, '', location.pathname);
    } else if (qs.get('ik_pay')) {
      var review = qs.get('ik_pay') === 'review';
      history.replaceState(null, '', location.pathname);
      shell(); root.classList.add('is-open'); document.documentElement.style.overflow = 'hidden';
      if (review) state.done = true;
      screen('<h3>' + (review ? 'Payment received' : 'Payment didn’t go through') + '</h3><p>' + (review ? 'We got your payment and are confirming your order. You’ll hear from us shortly. Please don’t pay again.' : 'No money was taken. Your cart is saved, you can try again or choose Cash on delivery.') + '</p><button type="button" class="ikx-btn" data-ikx-close>' + (review ? 'OK' : 'Back to cart') + '</button>');
    }
  }

  /* ---------- take over the Horizon cart drawer ---------- */
  function drawerWanted() {
    if (!AUTO_OPEN_ON_ADD && Date.now() - lastAddAt < 4000) { setTimeout(function () { getCart().then(bumpPill).catch(function () {}); }, 150); return; }
    openSheet('cart');
  }
  /* Patch at class level: the drawer element is replaced whenever the cart section re-renders. */
  function takeOverDrawer() {
    var D = window.HTMLDialogElement && HTMLDialogElement.prototype;
    if (D && !D.__ikx) {
      D.__ikx = true;
      ['showModal', 'show'].forEach(function (m) {
        var orig = D[m]; if (!orig) return;
        D[m] = function () {
          if (this.closest && this.closest('#cart-drawer')) { drawerWanted(); return; }
          return orig.apply(this, arguments);
        };
      });
    }
    if (!window.customElements) return;
    customElements.whenDefined('theme-drawer').then(function () {
      var C = customElements.get('theme-drawer');
      if (!C || C.prototype.__ikx) return;
      C.prototype.__ikx = true;
      var orig = C.prototype.open;
      C.prototype.open = function () {
        if (this.id === 'cart-drawer') { drawerWanted(); return; }
        return orig.apply(this, arguments);
      };
      /* Horizon re-opens a drawer left open on the previous page; close it so the page isn't scroll-locked. */
      var d = document.getElementById('cart-drawer');
      if (d && d.hasAttribute('open') && typeof d.close === 'function') { try { d.close(); } catch (e) {} }
    });
  }

  /* Checkout buttons anywhere → sheet scrolled to delivery. Cart icon / cart links → sheet at the top. */
  document.addEventListener('click', function (e) {
    var t = e.target instanceof Element ? e.target : null;
    if (!t || t.closest('.ikx-root')) return;
    var co = t.closest(CHECKOUT_SEL);
    if (co) {
      e.preventDefault(); e.stopImmediatePropagation();
      if (co.matches('.shopify-payment-button__button, button[name="buy"]')) {
        /* Buy it now: add this product first, then open checkout. */
        var f = co.closest('form'), id = f && f.querySelector('[name="id"]');
        if (id && id.value) {
          fetch(R + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: [{ id: Number(id.value), quantity: 1 }] }) })
            .then(function () { lastAddAt = 0; openSheet('checkout', co); }).catch(native);
          return;
        }
      }
      openSheet('checkout', co).catch(native);
      return;
    }
    if (TEMPLATE === 'cart') return;
    var cl = t.closest(CART_SEL);
    if (cl) { e.preventDefault(); e.stopImmediatePropagation(); if (!e.isTrusted) drawerWanted(); else openSheet('cart', cl); }
  }, true);

  /* Instant feedback on Add to cart: ikl-cart.js fires ikx:adding before Shopify answers (about 1 s),
     so the pill shows "Adding to cart…" straight away; the real cart replaces it when the add finishes. */
  document.addEventListener('ikx:adding', function (e) {
    lastAddAt = Date.now();
    if (TEMPLATE === 'cart' || isOpen()) return;
    paintPill(); if (!pill) return;
    var n = (CART && CART.item_count || 0) + ((e.detail && e.detail.quantity) || 1);
    pill.innerHTML = '<span class="ikx-pill__img"><i class="ikx-spin"></i></span><span class="ikx-pill__txt"><b>Adding to cart…</b><span>' + n + ' item' + (n > 1 ? 's' : '') + '</span></span>';
    pill.classList.add('is-adding'); pill.hidden = false; bumpPill();
  });
  document.addEventListener('ikx:add-failed', function () { paintPill(); });
  /* Shopify's add answer already has the new line: show the real pill right away, without waiting for /cart.js. */
  document.addEventListener('ikx:added', function (e) {
    var d = e.detail || {}, items = d.items || (d.key ? [d] : []);
    if (!items.length || pending) return;
    var c = clone(CART || { items: [], item_count: 0, total_price: 0 });
    items.forEach(function (it) {
      var ex = c.items.filter(function (i) { return i.key === it.key; })[0];
      if (ex) { ex.quantity = it.quantity; ex.original_line_price = ex.original_price * it.quantity; }
      else c.items.unshift(it);
    });
    recount(c); CART = c;
    if (!isOpen()) { paintPill(); bumpPill(); }
  });

  takeOverDrawer();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  window.addEventListener('pageshow', function (e) { if (e.persisted) getCart().catch(function () {}); });
  window.IKExpress = { open: function (where) { return openSheet(where || 'cart'); }, close: closeSheet };
})();
