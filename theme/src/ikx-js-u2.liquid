  var PRE = null, prepT = 0;
  function preSig(d) { var q = state.quote; return JSON.stringify([state.lines, d && [d.phone, d.name, d.email, d.pincode, d.city, d.state, d.address1, d.address2], q && q.prepaid && q.prepaid.total]); }
  function prepSoon() { clearTimeout(prepT); prepT = setTimeout(prep, 700); }
  function prep() {
    if (!IS_MOBILE || !root || !isOpen() || state.busy || state.done || !state.quote || !state.final || !$('.ikx-pay', root)) return;
