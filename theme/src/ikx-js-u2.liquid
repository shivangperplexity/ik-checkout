  /* Badges on the other rows: online = green "10% OFF", COD = grey "₹X more" */
  var paintPay1 = paintPay;
  paintPay = function () {
    paintPay1(); prepSoon();
    var q = state.quote, box = $('.ikx-pay', root); if (!q || !box) return;
    var pre = q.prepaid, cod = q.cod, off = (pre.prepaid || 0) + (pre.ref || 0) + (pre.credit || 0);
