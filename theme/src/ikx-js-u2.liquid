    p.then(function (r) { if (PRE === me && !(r && r.ok && r.method === 'prepaid' && r.upi && r.upi.uri)) PRE = null; }, function () { if (PRE === me) PRE = null; });
  }
  document.addEventListener('input', function (e) { if (root && e.target instanceof Element && root.contains(e.target)) prepSoon(); }, true);
  document.addEventListener('change', function (e) { if (root && e.target instanceof Element && root.contains(e.target)) prepSoon(); }, true);
  var api0 = api;
  api = function (path, body, method) {
