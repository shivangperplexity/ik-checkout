    paintShip();
  }

  /* ---------- remembered buyer (this device only; what Shopify does with a saved address) ---------- */
  var REMEMBER = true;
  try { REMEMBER = localStorage.getItem('ikx_remember') !== '0'; } catch (e) {}
  function savedBuyer() { try { return JSON.parse(localStorage.getItem('ikx_buyer') || 'null'); } catch (e) { return null; } }
  function rememberBuyer(d) {
    try {
      localStorage.setItem('ikx_remember', REMEMBER ? '1' : '0');
      if (!REMEMBER) return forgetBuyer();
      var keep = {}; ['phone', 'first_name', 'last_name', 'pincode', 'city', 'state', 'address1', 'address2', 'email'].forEach(function (k) { keep[k] = d[k] || ''; });
      localStorage.setItem('ikx_buyer', JSON.stringify(keep));
    } catch (e) {}
  }
  function forgetBuyer() { try { localStorage.removeItem('ikx_buyer'); } catch (e) {} }

  /* ---------- per-field errors (Shopify shows the message under the field, in red) ---------- */
  function fieldError(name, clearOnly) {
    var f = form(); if (!f || !name) return;
    var wrap = $('.ikx-in[data-f="' + name + '"]', f), msg = wrap && $('.ikx-ferr', wrap); if (!wrap || !msg) return;
    var bad = invalid(formData()), mine = bad && bad[0] === name ? bad[1] : '';
    if (clearOnly && mine) return; /* don't shout while they're still typing */
    wrap.classList.toggle('is-bad', !!mine); msg.textContent = mine; msg.hidden = !mine;
  }

  /* ---------- shipping method (Shopify step 3) with a live NimbusPost estimate ----------
     GET {API}/api/shipping?pin=411001&cod=1  →  { ok, edd: "Mon, 13 Oct", days: 2 }
     The API asks NimbusPost (Delhivery / Xpressbees, from the 410206 warehouse) and returns only the fastest
     estimated delivery date. The shopper sees one option, "Express shipping", never the courier's name. */
  var SHIP = { pin: '', cod: '', edd: null, busy: false };
  function fetchShipping() {
    var d = formData(), pin = d.pincode, cod = state.method === 'cod' ? '1' : '0';
    if (!/^\d{6}$/.test(pin)) return;
    if (SHIP.pin === pin && SHIP.cod === cod && (SHIP.edd !== null || SHIP.busy)) return;
    SHIP = { pin: pin, cod: cod, edd: null, busy: true }; paintShip();
    fetch(API + '/api/shipping?pin=' + pin + '&cod=' + cod).then(function (r) { return r.json(); }).then(function (j) {
      if (SHIP.pin !== pin || SHIP.cod !== cod) return;
      SHIP.busy = false; SHIP.edd = (j && j.ok && j.edd) ? String(j.edd) : '';
      paintShip();
      if (state.quote) track('AddShippingInfo', { currency: 'INR', value: state.quote[qk(state.method)].total / 100, shipping_tier: 'Express' });
      tkOnce('shipping', { data: { pin: pin, edd: SHIP.edd } });
    }).catch(function () { if (SHIP.pin === pin) { SHIP.busy = false; SHIP.edd = ''; paintShip(); } });
  }
  function paintShip() {
    var box = $('.ikx-ship', root); if (!box) return;
    var d = formData(), hasAddr = /^\d{6}$/.test(d.pincode) && d.city && d.state;
    if (!hasAddr) { box.innerHTML = '<div class="ikx-shipnote">Enter your shipping address to view available shipping methods.</div>'; return; }
    fetchShipping();
    var p = state.quote && state.quote[qk(state.method)], price = p ? (p.shipping ? money(p.shipping) : 'FREE') : 'FREE';
    var when = SHIP.busy ? '<i class="ikx-spin ikx-spin--pin"></i> Checking delivery date for ' + esc(d.pincode) + '…'
      : SHIP.edd ? 'Arrives by ' + esc(SHIP.edd) : 'Delivery in 2–5 business days';
    box.innerHTML = '<div class="ikx-shipopt is-on" role="radio" aria-checked="true"><span class="ikx-radio" aria-hidden="true"></span>' +
      '<span class="ikx-shipopt__t"><b>Express shipping</b><span class="ikx-m">' + when + (state.method !== 'cod' ? ' · prepaid orders ship first' : '') + '</span></span>' +
      '<b class="' + (p && p.shipping ? '' : 'ikx-green') + '">' + price + '</b></div>';
  }

