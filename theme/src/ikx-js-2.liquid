  /* ---------- paint now, confirm the price in the background ---------- */
  var renderSeq = 0, CART_SHOWN = null;
  function setQuote(q, final) {
    state.quote = q; state.final = !!final; state.quoteSig = sigOf(state.lines);
    if (q.px) setPx(q.px);
    if (final) { state.ups = q.upsells || []; state.logos = q.upi_logos || {}; }
  }
  function render(c) {
    var seq = ++renderSeq;
    CART = c; CART_SHOWN = c;
    if (!c.item_count) { state.quote = null; state.final = false; return emptyView(); }
    var ups = state.lines.filter(function (l) { return l.upsell; });
    state.lines = linesOf(c).concat(ups);
    var sig = sigOf(state.lines), hit = cachedQuote(state.lines), firstPaint = !state.built;
    if (hit) setQuote(hit, true);
    else if (!state.quote || state.quoteSig !== sig || !state.final) setQuote(estimate(c), false);
    if (!state.idem) state.idem = uuid();
    if (firstPaint) {
      tk('open', { cart: c.items.map(function (i) { return { t: i.product_title, q: i.quantity, p: i.original_price }; }) });
      track('InitiateCheckout', { currency: 'INR', value: state.quote.cod.afterBogo / 100, num_items: c.item_count });
    }
    paintAll();
    if (state.final) return;
    fetchQuote(state.lines).then(function (q) {
      if (seq !== renderSeq) return;
      setQuote(q, true); paintUps(); paintPay(); paintBill(); paintFoot();
    }).catch(function (err) {
      if (seq !== renderSeq) return;
      console.warn('[ik-express] quote unavailable, offering Shopify checkout', err);
      state.quote = null; state.final = false; paintAll();
    });
  }
  function refresh() { return getCart().then(function (c) { render(c); }); }

