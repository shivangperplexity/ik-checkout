  /* ---------- main sheet (built once per open, so typed details survive cart changes) ---------- */
  /* Build 036: the form follows Shopify checkout's order and data exactly, in IK's own UI.
       1. Contact      → phone (Shopify: email or phone), optional email for the receipt
       2. Delivery     → name, address, apartment/landmark, PIN → city + state (country fixed: India)
       3. Shipping     → one row that shows the method and price once the address is in (Shopify's "Shipping method")
       4. Payment      → tiles (Shopify's payment list; billing address = delivery address)
       5. Summary      → bill rows, then ONE "Pay now" / "Complete order" button (Shopify never uses a slider)
     Like Shopify, a returning shopper's contact + address is pre-filled (kept on this device only, see REMEMBER). */
  function buildMain() {
    var opts = STATES.map(function (s) { return '<option>' + s + '</option>'; }).join('');
    /* Shopify-style field: placeholder shows when empty, the label floats up once there is a value. */
    function field(name, label, extra, type) {
      var inner = type === 'select'
        ? '<select name="' + name + '" ' + (extra || '') + '><option value="" disabled>' + label + '</option>' + opts + '</select>'
        : '<input name="' + name + '" placeholder=" " ' + (extra || '') + '>';
      return '<label class="ikx-in ikx-in--float" data-f="' + name + '">' + inner + '<span>' + label + '</span><em class="ikx-ferr" hidden></em></label>';
    }
    scroller().innerHTML =
      '<div class="ikx-grab" aria-hidden="true"></div>' +
      '<div class="ikx-head"><h2 class="ikx-h">Your cart</h2><span class="ikx-secure">' + ICON.lock + 'Secure checkout</span><button type="button" class="ikx-x" data-ikx-close aria-label="Close">' + ICON.close + '</button></div>' +
      '<div class="ikx-offer"></div>' +
      '<ul class="ikx-items" aria-label="Items in your cart"></ul>' +
      '<div class="ikx-picks"></div>' +
      '<form class="ikx-form" id="ikx-co" method="post" action="#" autocomplete="on" novalidate>' +
        /* 1. Contact — Shopify's layout, but the mobile number is the contact (compulsory); email is optional, at the end */
        '<div class="ikx-sec"><h3 class="ikx-h3">Contact<a class="ikx-link" href="' + R + 'account/login">Sign in</a></h3>' +
          '<label class="ikx-in ikx-in--float" data-f="phone"><span class="ikx-cc">+91</span><input name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" placeholder=" " required><span>Mobile number</span><em class="ikx-ferr" hidden></em></label>' +
          '<label class="ikx-check"><input type="checkbox" name="news" checked><span>Send me order updates and offers on WhatsApp</span></label>' +
        '</div>' +
        /* 2. Delivery */
        '<div class="ikx-sec"><h3 class="ikx-h3">Delivery</h3>' +
          '<label class="ikx-in ikx-in--float is-filled" data-f="country"><select name="country" autocomplete="shipping country"><option value="IN" selected>India</option></select><span>Country/Region</span><i class="ikx-ic ikx-in__chev">' + ICON.down + '</i></label>' +
          '<div class="ikx-row2">' + field('first_name', 'First name', 'autocomplete="shipping given-name" required') + field('last_name', 'Last name', 'autocomplete="shipping family-name" required') + '</div>' +
          field('address1', 'Address', 'autocomplete="shipping address-line1" required') +
          field('address2', 'Apartment, suite, etc.', 'autocomplete="shipping address-line2"') +
          '<div class="ikx-row3">' + field('city', 'City', 'autocomplete="shipping address-level2" required') + field('state', 'State', 'autocomplete="shipping address-level1" required', 'select') + field('pincode', 'PIN code', 'inputmode="numeric" autocomplete="shipping postal-code" maxlength="6" required') + '</div>' +
          '<label class="ikx-check"><input type="checkbox" name="remember" ' + (REMEMBER ? 'checked' : '') + '><span>Save this information for next time</span></label>' +
          field('email', 'Email (optional, for your order receipt)', 'type="email" inputmode="email" autocomplete="email"') +
        '</div>' +
        /* 3. Shipping method — real options from NimbusPost once the address is in */
        '<div class="ikx-sec"><h3 class="ikx-h3">Shipping method</h3><div class="ikx-ship" role="radiogroup" aria-label="Shipping method"></div></div>' +
        '<div class="ikx-ups"></div>' +
        /* 4. Payment */
        '<div class="ikx-sec"><h3 class="ikx-h3">Payment</h3><p class="ikx-m ikx-h3sub">All transactions are secure and encrypted.</p>' +
          '<div class="ikx-pay" role="radiogroup" aria-label="Payment method"></div>' +
          '<p class="ikx-m ikx-billing">Billing address: same as shipping address</p>' +
        '</div>' +
        /* 5. Order summary */
        '<details class="ikx-bill" open><summary>Order summary<span class="ikx-ic">' + ICON.down + '</span></summary><div class="ikx-bill__rows"></div></details>' +
        '<p class="ikx-fine">' + ICON.lock + 'Payments secured by PayU · 7-day replacement guarantee</p>' +
      '</form>';
    state.built = true;
    var f = form();
    f.addEventListener('change', function (e) {
      if (e.target.name === 'phone') e.target.value = tenDigits(e.target.value);
      if (e.target.name === 'remember') { REMEMBER = e.target.checked; if (!REMEMBER) forgetBuyer(); }
