  /* ---------- sheet shell ---------- */
  var root = null, opener = null;
  var state = { upiApp: 'gpay', quote: null, lines: [], method: 'upi', idem: '', busy: false, done: false, leadTimer: null, built: false, ups: [], logos: {}, pinOk: false, final: false, quoteSig: '' };
  function isOpen() { return !!(root && root.classList.contains('is-open')); }
  function scroller() { return $('.ikx-scroll', root); }
  function form() { return root && $('.ikx-form', root); }
  function closeModals() {
    $$('dialog[open]').forEach(function (d) { if (!d.closest('.ikx-root')) { try { d.close(); } catch (e) {} } });
    document.documentElement.style.overflow = '';
  }
  function shell() {
    if (root) return;
    root = el('div', { class: 'ikx-root', role: 'dialog', 'aria-modal': 'true', 'aria-label': 'Your cart and checkout' },
      '<div class="ikx-backdrop" data-ikx-close></div>' +
