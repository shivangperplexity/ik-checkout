      '<div class="ikx-slide' + (state.busy ? ' is-busy' : '') + '" role="button" tabindex="0" aria-label="' + esc(label) + '. Press Enter to confirm.">' +
        '<i class="ikx-slide__fill" aria-hidden="true"></i><span class="ikx-slide__label" aria-hidden="true">' + esc(label) + '</span>' +
        '<span class="ikx-slide__knob" aria-hidden="true">' + ICON.dbl + '</span></div>';
    bindSlide($('.ikx-slide', foot));
  }

  /* Slide to pay (phones). Moves on the compositor (translate3d, one paint per frame), eases back with a soft
     spring, accepts a quick flick, and gives a light buzz when it locks in. */
  function bindSlide(track) {
    var knob = $('.ikx-slide__knob', track), fill = $('.ikx-slide__fill', track), label = $('.ikx-slide__label', track);
    var x = 0, startX = 0, drag = false, max = 1, kw = 50, tw = 1, frame = 0, armed = false, lastX = 0, lastT = 0, vel = 0;
    function measure() { kw = knob.offsetWidth || 50; tw = track.clientWidth || 1; max = Math.max(1, tw - kw - 10); }
    function paint() {
      frame = 0;
      knob.style.transform = 'translate3d(' + x + 'px,0,0)';
      fill.style.transform = 'translate3d(' + (x + kw + 10 - tw) + 'px,0,0)';
      label.style.opacity = String(Math.max(0, 1 - x / (max * 0.55)));
    }
    function set(v, anim) {
      x = v;
      var t = anim ? 'transform .34s cubic-bezier(.22,1,.36,1)' : 'none';
      knob.style.transition = fill.style.transition = t;
      label.style.transition = anim ? 'opacity .34s ease' : 'none';
      if (anim) { if (frame) cancelAnimationFrame(frame); paint(); }
      else if (!frame) frame = requestAnimationFrame(paint);
    }
    function buzz(ms) { try { if (navigator.vibrate) navigator.vibrate(ms); } catch (e) {} }
    function commit() {
      if (state.busy) return;
      measure(); set(max, true); track.classList.add('is-done'); buzz(18);
      label.textContent = state.method === 'cod' ? 'Placing order…' : 'Opening payment…';
      label.style.transition = 'none'; label.style.opacity = '1';
      submit();
    }
    knob.addEventListener('pointerdown', function (e) {
      if (state.busy) return;
      measure(); drag = true; armed = false;
      startX = e.clientX - x; lastX = e.clientX; lastT = e.timeStamp; vel = 0;
      try { knob.setPointerCapture(e.pointerId); } catch (er) {}
      track.classList.add('is-drag');
      knob.style.transition = fill.style.transition = label.style.transition = 'none';
    });
    knob.addEventListener('pointermove', function (e) {
      if (!drag) return;
      var dt = e.timeStamp - lastT;
      if (dt > 0) vel = 0.6 * vel + 0.4 * ((e.clientX - lastX) / dt);
      lastX = e.clientX; lastT = e.timeStamp;
      set(Math.max(0, Math.min(max, e.clientX - startX)));
      var ok = x >= max * 0.8;
      if (ok !== armed) { armed = ok; track.classList.toggle('is-release', ok); if (ok) buzz(8); }
    });
    function end() {
      if (!drag) return;
      drag = false; track.classList.remove('is-drag', 'is-release');
      if (x >= max * 0.8 || (vel > 0.8 && x > max * 0.35)) commit(); else set(0, true);
    }
    knob.addEventListener('pointerup', end); knob.addEventListener('pointercancel', end);
    track.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); commit(); } });
    measure(); set(0);
  }

  function showErr(msg) {
    var e = root && $('.ikx-err', root); if (!e) return;
    e.textContent = msg || ''; e.hidden = !msg;
  }

  /* Scroll to the delivery form and focus the first missing field. */
  function goCheckout(focus) {
    var f = form(); if (!f) return;
    var bad = invalid(formData());
    f.scrollIntoView({ block: 'start', behavior: 'smooth' });
    if (focus && bad) { var inp = f.elements[bad[0]]; if (inp) setTimeout(function () { inp.focus({ preventScroll: true }); }, 350); }
  }

  /* ---------- clicks inside the sheet ---------- */
  function onClick(e) {
    var t = e.target instanceof Element ? e.target : null; if (!t) return;
    if (t.closest('[data-ikx-close]')) { e.preventDefault(); closeSheet(); return; }
    var q = t.closest('[data-ikx-qty]');
    if (q) { e.preventDefault(); if (!state.busy) changeQty(q.closest('[data-key]').getAttribute('data-key'), parseInt(q.getAttribute('data-ikx-qty'), 10)); return; }
    var a = t.closest('[data-ikx-add]');
    if (a) { e.preventDefault(); if (!state.busy) { closeAsk(); addPick(a.getAttribute('data-ikx-add')); } return; }
    if (t.closest('[data-ikx-askx]')) { e.preventDefault(); closeAsk(); return; }
    if (t.closest('[data-otp-x]')) { e.preventDefault(); otpClose(); state.busy = false; paintFoot(); return; }
    if (t.closest('[data-ikx-code-open]')) { e.preventDefault(); state.codeOpen = true; state.codeErr = ''; paintCode(); var ci = $('[data-ikx-code-in]', root); if (ci) ci.focus(); return; }
    if (t.closest('[data-ikx-code-go]')) { e.preventDefault(); var cv = ($('[data-ikx-code-in]', root) || {}).value || ''; if (document.activeElement) document.activeElement.blur(); if (cv.trim()) setCode(cv); return; }
    if (t.closest('[data-ikx-code-x]')) { e.preventDefault(); setCode(''); return; }
    if (t.closest('[data-otp-re]')) { e.preventDefault(); otpSend(true); return; }
    if (t.closest('[data-otp-paste]')) { e.preventDefault(); otpPaste(); return; }
    if (t.closest('[data-otp-edit]')) { e.preventDefault(); otpClose(); state.busy = false; paintFoot(); var pf = form() && form().elements.phone; goCheckout(false); if (pf) setTimeout(function () { pf.focus(); pf.select && pf.select(); }, 350); return; }
    if (t.closest('[data-ikx-skip]')) { e.preventDefault(); SKIP_FREE = true; try { sessionStorage.setItem('ikx_skipfree', '1'); } catch (er) {} closeAsk(); paintFoot(); submit(); return; }
    if (t.closest('[data-ikx-gofree]')) { e.preventDefault(); var ob = $('.ikx-offer', root); if (ob) ob.scrollIntoView({ block: 'start', behavior: 'smooth' }); return; }
    var m = t.closest('[data-ikx-method]');
    if (m) { e.preventDefault(); if (state.busy) return; state.method = m.getAttribute('data-ikx-method'); paintPay(); paintShip(); paintBill(); paintFoot(); tk('method', { method: state.method }); if (m.hasAttribute('data-ikx-go')) submit(); return; }
    var u = t.closest('[data-ikx-upi]');
    if (u) {
      e.preventDefault(); if (state.busy) return; state.upiApp = u.getAttribute('data-ikx-upi');
      /* Build 045: a UPI app tile in the payment card pays straight away in that app; the ₹99 advance picker only selects */
      if (u.hasAttribute('data-ikx-go')) { state.method = 'upi'; paintPay(); paintShip(); paintBill(); paintFoot(); tk('method', { method: 'upi', data: { app: state.upiApp } }); submit(); return; }
      paintPay(); paintFoot(); tk('method', { method: 'upi', data: { app: state.upiApp } }); return;
    }
    var up = t.closest('[data-ikx-up]');
    if (up) { e.preventDefault(); if (!state.busy) toggleUp(up.getAttribute('data-ikx-up')); return; }
    if (t.closest('[data-ikx-pay]')) { e.preventDefault(); submit(); return; }
    if (t.closest('[data-ikx-next]')) { e.preventDefault(); var bad = invalid(formData()); goCheckout(true); if (bad && formTouched()) { fieldError(bad[0]); showErr(bad[1]); } return; }
  }
  function formTouched() { var d = formData(); return !!(d.phone || d.pincode || d.name || d.address1); }

  /* ---------- abandoned-order capture ---------- */
  function sendLead(step, immediate) {
    if (!form()) return;
    clearTimeout(state.leadTimer);
    var go = function () {
      if (!form()) return; /* the form is gone once the order is placed */
      var d = formData(); if (!/^[6-9]\d{9}$/.test(d.phone)) return;
      refCheck(d.phone);
      var a = attrNow();
      api('/api/lead', { phone: d.phone, name: d.name, pincode: d.pincode, lines: state.lines, utm: attribution, fbp: a.fbp, fbc: a.fbc, step: step }).catch(function () {});
    };
    if (immediate) go(); else state.leadTimer = setTimeout(go, 1500);
  }
  window.addEventListener('pagehide', function () { sendLead('left', true); if (isOpen()) tk('left'); });

  /* " with Google Pay" on the footer button when a UPI app is picked on a phone */
  function payVia() {
    if (state.method !== 'upi' || !IS_MOBILE) return '';
    var a = (UPI_APPS.filter(function (x) { return x[0] === state.upiApp; })[0] || [])[1];
    return a && state.upiApp !== 'any' ? ' with ' + a : ' by UPI';
  }
  /* The API says Cash on delivery is switched off: drop the COD option, forget the cached price, move to UPI. */
  function codGone(msg) {
    if (state.quote) state.quote.cod_on = false;
    QC = {}; saveQC(); state.idem = uuid(); state.otpSkip = false;
    if (state.method === 'cod') state.method = 'upi';
    paintPay(); paintShip(); paintBill(); paintFoot();
    showErr(msg || 'Cash on delivery is not available right now. Please pay by UPI or card.');
  }

  /* ---------- submit ---------- */
  function submit() {
    if (state.busy || !state.quote || !state.final) return;
    var d = formData(); showErr('');
    var bad = invalid(d);
    if (bad) { paintFoot(); fieldError(bad[0]); goCheckout(true); return showErr(bad[1]); }
    if (SHIP.no && SHIP.pin === d.pincode) { fieldError('pincode'); goCheckout(true); return showErr('Sorry, we can\u2019t deliver to PIN code ' + d.pincode + ' yet. Please use another address.'); }
    /* Build 039: no "you have 1 FREE tattoo" pop-up before paying (simpler checkout) */
    state.draft = d; rememberBuyer(d);
    var pcx = state.method === 'cod' && pcOn();
    /* Build 044: Cash on delivery (not part-paid) is verified with a 4-digit WhatsApp code first. The code box opens
       inside this tap (so the phone keyboard comes up) and the order is placed as soon as 4 digits are in. */
    if (state.method === 'cod' && !pcx && state.quote.otp && !state.otpSkip) {
      tk('submit', { phone: d.phone, name: d.name, method: state.method });
      track('AddPaymentInfo', { currency: 'INR', value: state.quote.cod.total / 100 });
      return otpOpen(d);
    }
    placeOrder(d, pcx, '');
  }
  function placeOrder(d, pcx, otp) {
    state.busy = true;
    if (!IS_MOBILE) paintFoot();
    if (!otp) {
      overlay(state.method === 'cod' && !pcx ? 'Placing your order…' : (state.method === 'upi' || pcx) && IS_MOBILE ? 'Opening your UPI app…' : 'Opening secure payment…');
      tk('submit', { phone: d.phone, name: d.name, method: state.method });
      track('AddPaymentInfo', { currency: 'INR', value: state.quote[qk(state.method)].total / 100 });
    }
    var upiApp = (state.method === 'upi' || pcx) && IS_MOBILE ? (state.upiApp || 'any') : '';
    api('/api/order', { idem: state.idem, method: pcx ? 'partial' : qk(state.method), lines: state.lines, buyer: d, attribution: attrNow(), upi: !!upiApp, pc: 1, pv: 2, otp: otp || undefined }).then(function (r) {
      if (!r.ok && r.otp_invalid) { state.busy = false; return otpError(r.error, r.expired); }
      otpClose();
      if (!r.ok && r.cod_off) { state.busy = false; hideOverlay(); tk('fail', { data: { error: 'cod_off' } }); return codGone(r.error); }
      if (!r.ok && r.partial_required) {
        /* the API wants the advance for this address (the check had not run, or the rules changed): show it */
        state.busy = false; hideOverlay(); state.idem = uuid();
        state.pcKey = pcKeyNow(); state.pcNeed = true; state.pcHint = r.hint || ''; if (r.advance) state.pcAdvance = r.advance;
        paintPay(); paintBill(); paintFoot(); tk('fail', { data: { error: 'partial_required' } });
        return showErr(r.error);
      }
