    if (REF) box.innerHTML = '<span>Code <b>' + esc(REF) + '</b>' + (p.ref ? ' · ' + money(p.ref) + ' off when you pay online' : '') + '</span> <button type="button" class="ikx-link" data-ikx-code-x>Remove</button>' + err;
    else if (state.codeOpen) box.innerHTML = '<div style="display:flex;gap:8px"><input data-ikx-code-in autocomplete="off" autocapitalize="characters" placeholder="Creator, referral or voucher code" style="flex:1;min-width:0;border:1px solid #d9d4cb;border-radius:10px;padding:10px 12px;font:inherit;font-size:16px;text-transform:uppercase"><button type="button" class="ikx-btn" data-ikx-code-go style="width:auto;padding:0 16px;min-height:42px">Apply</button></div>' + err;
    else box.innerHTML = '<button type="button" class="ikx-link" data-ikx-code-open>Have a creator or referral code?</button>' + err;
