      return;
    }
    pcCheck(); /* background: starts once mobile, PIN and address are in */
    var p = state.quote[qk(state.method)], save = savings(p), was = p.subtotal + (p.shipping || 0) + (p.cod || 0);
    var pcx = state.method === 'cod' && pcOn();
    var label = pcx ? 'Slide to pay ' + money(pcAdv()) + ' & place order' : state.method === 'cod' ? 'Slide to place order · ' + money(p.total) : 'Slide to pay ' + money(p.total) + payVia();
    var btnLabel = pcx ? 'Pay ' + money(pcAdv()) + ' & place order' : state.method === 'cod' ? 'Complete order · ' + money(p.total) : 'Pay ' + money(p.total) + payVia();
    var unclaimed = false; /* Build 039: the offer lives in the bar above the items only */
    var top = (unclaimed ? '<button type="button" class="ikx-freenote" data-ikx-gofree>🎁 1 FREE tattoo unclaimed · <u>Pick one</u></button>' : '') +
      '<div class="ikx-tot"><span class="ikx-green">' + (save ? 'You’re saving ' + money(save) : (p.shipping ? 'Delivery ' + money(p.shipping) : 'Free delivery')) + '</span>' +
      '<span>' + (was > p.total ? '<s>' + money(was) + '</s>' : '') + '<b>' + money(p.total) + '</b></span></div><p class="ikx-err" role="alert" hidden></p>';
    if (!ready()) {
      var bad = invalid(formData()), where = bad && bad[0] === 'phone' ? 'Add your mobile number' : 'Add delivery details';
      foot.innerHTML = top + '<button type="button" class="ikx-btn" data-ikx-next>' + where + '<span class="ikx-ic">' + ICON.down + '</span></button>';
      return;
    }
    if (!state.final) {
      foot.innerHTML = top + '<button type="button" class="ikx-btn" disabled><i class="ikx-spin ikx-spin--sm"></i>Confirming your total…</button>';
      return;
