      row(rk === 'creator' ? 'Creator code' + rn : rk === 'voucher' ? 'Creator voucher' : 'Referral' + rn, '−' + money(p.ref), 'is-save'); }
    if (p.credit) row('Store credit', '−' + money(p.credit), 'is-save');
    row('Delivery', p.shipping ? money(p.shipping) : 'FREE', p.shipping ? '' : 'is-save');
