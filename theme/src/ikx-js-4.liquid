    if ((state.method !== 'cod' || pcx) && !((state.method === 'upi' || pcx) && IS_MOBILE)) loadBolt(false).catch(function () {});
    /* Build 036: one button everywhere, worded like Shopify ("Pay now" / "Complete order").
