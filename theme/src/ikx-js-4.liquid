  function paintCode() {
    var bill = $('.ikx-bill', root); if (!bill) return;
    var box = $('.ikx-code', bill);
    if (!box) { box = el('div', { class: 'ikx-code', style: 'margin:10px 2px 0;font-size:13.5px' }); bill.appendChild(box); }
    if (box.contains(document.activeElement)) return;
