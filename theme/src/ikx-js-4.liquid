    clearTimeout(state.pcT);
    state.pcT = setTimeout(function () {
      if (pcKeyNow() !== key || state.pcAsk === key || !pcInputs()) return;
      state.pcAsk = key; var d = formData();
      function done(j) {
        if (state.pcAsk === key) state.pcAsk = '';
        if (pcKeyNow() !== key || state.busy) return;
        state.pcKey = key; state.pcNeed = !!(j && j.partial); state.pcHint = (j && j.hint) || '';
        if (j && j.advance) state.pcAdvance = j.advance;
