  function pcInputs() { var d = form() ? formData() : null; return !!(d && /^[6-9]\d{9}$/.test(d.phone) && /^\d{6}$/.test(d.pincode) && d.address1.length >= 5); }
  function pcWaiting() { return pcFlag().mode === 'check' && !!state.quote && !state.quote.estimate && pcInputs() && state.pcKey !== pcKeyNow(); }
  function pcCheck() {
    if (!pcWaiting()) return;
