  /* ---------- footer: total + (Add delivery details | Slide to pay) ---------- */
  function savings(p) { return (p.bogo || 0) + (p.prepaid || 0) + (p.upsell || 0) + (p.ref || 0) + (p.credit || 0); }
  var SLIDE_TO_PAY = false;
  function paintFoot() {
