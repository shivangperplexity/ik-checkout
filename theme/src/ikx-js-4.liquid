/* ik-express.js part 4 of 5 (rendered inline by snippets/ik-checkout.liquid) */
      return '<button type="button" class="ikx-upib' + (a[0] === state.upiApp ? ' is-on' : '') + '" data-ikx-upi="' + a[0] + '" aria-pressed="' + (a[0] === state.upiApp) + '"><span class="ikx-upib__ic">' + upiIcon(a[0]) + '</span>' + a[1] + '</button>';
