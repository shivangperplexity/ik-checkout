    if (!IS_MOBILE || !SLIDE_TO_PAY) {
      foot.innerHTML = top + '<button type="button" class="ikx-btn ikx-paybtn" data-ikx-pay' + (state.busy ? ' disabled' : '') + '>' + ICON.lock + esc(state.busy ? (state.method === 'cod' && !pcx ? 'Placing order…' : 'Opening payment…') : btnLabel) + '</button>';
      return;
    }
