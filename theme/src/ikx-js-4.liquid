  /* ---------- partial COD: pay the advance (₹99) online now, the rest on delivery ----------
     /api/quote says partial.mode: 'off' (never), 'all' (every COD order) or 'check' (the API decides per address:
     a vague address with no house / flat / shop number, a high-return PIN, a number with past returns...). In 'check'
     mode the sheet asks /api/cod-check once the delivery details are complete, and the COD tile, bill and button
     follow the answer. The API checks again when the order is placed (lib/partial-cod.js). */
  function pcFlag() { return (state.quote && state.quote.partial) || { mode: 'off', advance: 9900 }; }
  function pcAdv() { return state.pcAdvance || pcFlag().advance || 9900; }
  function pcKeyNow() { var d = form() ? formData() : {}; return [d.phone, d.pincode, d.address1, d.address2, state.quote && state.quote.cod ? state.quote.cod.total : ''].join('|'); }
  function pcOn() {
