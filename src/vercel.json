{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/5 * * * *"
    }
  ],
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.codwing.com"
        }
      ],
      "destination": "/api/x?a=cw&b=app"
    },
    {
      "source": "/sf.js",
      "destination": "/cw-sf.js"
    },
    {
      "source": "/demo",
      "destination": "/cw-demo.html"
    },
    {
      "source": "/partner",
      "destination": "/cw-partner.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/creator",
      "destination": "/creator.html"
    },
    {
      "source": "/refer",
      "destination": "/refer.html"
    },
    {
      "source": "/c/:code",
      "destination": "/api/x?a=creator&b=go&code=:code"
    },
    {
      "source": "/review/:t",
      "destination": "/api/x?a=review&b=page&t=:t"
    },
    {
      "source": "/api/:a/:b",
      "destination": "/api/x?a=:a&b=:b"
    }
  ],
  "functions": {
    "api/[[...slug]].js": {
      "includeFiles": "node_modules/{pdfjs-dist/legacy/build/pdf.worker.mjs,pdfjs-dist/standard_fonts/**,@napi-rs/**}",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/collab",
      "destination": "https://www.inkkulture.in/pages/collab",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/cw-sf.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}